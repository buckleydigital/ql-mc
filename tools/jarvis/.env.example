# QuoteLeads MCP server — copy to .env and fill in the key.
# .env is gitignored. Never commit a real key.

# The QuoteLeads Supabase project.
QL_SUPABASE_URL=https://wmegoygrancfwxagqskh.supabase.co

# Service-role key (Supabase dashboard > Project Settings > API).
# Service-role reads past RLS, which is what a single-operator assistant needs.
# It stays on this machine: the server runs locally and exposes no tool that
# runs caller-supplied SQL.
QL_SUPABASE_KEY=

# Local business day. Everything "today" is computed in this zone, not UTC.
QL_TIMEZONE=Australia/Sydney

# Which `leads.stage` values count as won and as dead. Free text in the
# database, so it lives here where it can change without a code edit.
QL_WON_STAGES=won,closed won,client,signed
QL_DEAD_STAGES=lost,dead,closed lost,disqualified

QL_CURRENCY=AUD

# Sending only. The send-sales-email and send-sms edge functions verify a USER
# token and attribute the send to that person (rep name and reply-to address),
# so a service-role key is not enough. Reads never use this.
QL_USER_EMAIL=
QL_USER_PASSWORD=
QL_SUPABASE_ANON_KEY=
